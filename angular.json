{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "temple-vastu-visualizer": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/temple-vastu-visualizer",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "styles": ["src/styles.css"]
          },
          "configurations": {
            "production": {
              "optimization": { "fonts": { "inline": false } },
              "budgets": [
                { "type": "initial", "maximumWarning": "500kB", "maximumError": "1MB" },
                { "type": "anyComponentStyle", "maximumWarning": "18kB", "maximumError": "22kB" }
              ],
              "outputHashing": "all"
            },
            "development": { "optimization": { "fonts": { "inline": false } }, "extractLicenses": false, "sourceMap": true }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": { "buildTarget": "temple-vastu-visualizer:build:production" },
            "development": { "buildTarget": "temple-vastu-visualizer:build:development" }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
